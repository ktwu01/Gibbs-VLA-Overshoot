#!/bin/bash
#PBS -N gibbs-round3
#PBS -q casper
#PBS -l select=1:ncpus=4:mem=64GB:ngpus=1:gpu_type=a100
#PBS -l walltime=03:00:00
#PBS -A UTAA0012
#PBS -j oe

# Force output to known location
exec > $HOME/Gibbs-VLA-Overshoot/gibbs-round3.out 2>&1

echo "=== START $(date) ==="
echo "=== Environment ==="
hostname
echo "PATH: $PATH"

# Load conda properly for PBS non-login shell
source /etc/profile.d/conda.sh 2>/dev/null || true
module load conda 2>/dev/null || true
conda activate gibbs312 2>/dev/null || source activate gibbs312 2>/dev/null
echo "Python: $(which python) $(python --version 2>&1)"

export HF_HOME=/glade/work/$USER/.cache/huggingface
cd $HOME/Gibbs-VLA-Overshoot
mkdir -p experiments/outputs

echo "=== GPU Info ==="
nvidia-smi
echo ""

# Single test experiment first
echo "========== r3_exp07: pi0 chunk=50 =========="
python -m experiments.chunked_swap_experiment \
    --model lerobot/pi0_base \
    --n-action-steps 50 \
    --output experiments/outputs/r3_exp07_pi0_c50.png \
    --total-steps 100 --switch-step 50 --axis 0 2>&1
RC=$?
echo "EXIT CODE: $RC"
echo ""

if [ $RC -eq 0 ] && [ -f experiments/outputs/r3_exp07_pi0_c50.json ]; then
    echo "=== FIRST EXPERIMENT SUCCEEDED! Running sweep ==="

    for NAS in 25 10 1; do
        echo "========== pi0 chunk=$NAS =========="
        python -m experiments.chunked_swap_experiment \
            --model lerobot/pi0_base \
            --n-action-steps $NAS \
            --output experiments/outputs/r3_exp_pi0_c${NAS}.png \
            --total-steps 100 --switch-step 50 --axis 0 2>&1
        echo ""
    done

    echo "========== pi0 chunk=50, sushi vs drawer =========="
    python -m experiments.chunked_swap_experiment \
        --model lerobot/pi0_base \
        --n-action-steps 50 \
        --output experiments/outputs/r3_exp_pi0_c50_sushi.png \
        --total-steps 100 --switch-step 50 --axis 0 \
        --instruction-a "pick up the sushi" \
        --instruction-b "close the drawer" 2>&1
    echo ""
else
    echo "=== FIRST EXPERIMENT FAILED (rc=$RC) ==="
fi

echo "=== ALL DONE $(date) ==="

# Summary
echo "=== SUMMARY ==="
for f in experiments/outputs/r3_exp*.json; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .json)
    python -c "
import json; d=json.load(open('$f'))
print(f'$name: ov={d[\"overshoot_percent\"]:.4f}%, n_as={d[\"n_action_steps\"]}')
" 2>/dev/null || echo "$name: PARSE ERROR"
done
